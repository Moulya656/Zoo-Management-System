<%- include('partials/header') %>

  <main>
    <section class="hero">
      <h1><%= pageTitle %></h1>

      <% if (animals.length === 0) { %>
        <p>No animals have been added to this category yet.</p>
      <% } %>

      <% animals.forEach(function(animal) { %>
        <figure>
          <img src="/<%= animal.imagePath %>" alt="<%= animal.name %>" style="width:100%; height: 212px; object-fit:cover;">
          <figcaption><strong><%= animal.name %></strong> – <%= animal.caption %></figcaption>
          <div class="animal-description">
            <p><strong>Scientific Name:</strong> <em><%= animal.scientificName %></em></p>
            <p><strong>Species:</strong> <%= animal.species %></p>
            <p><strong>Average Lifespan:</strong> <%= animal.lifespan %></p>
            <p><%= animal.description %></p>
          </div>
        </figure>
      <% }); %>

    </section>
  </main>

<%- include('partials/footer') %>

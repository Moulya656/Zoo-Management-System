# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub.

# ---- MongoDB connection string ----
# Option A (easiest, no install): MongoDB Atlas free cloud cluster
# Get this from https://www.mongodb.com/cloud/atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://zoomsadmin:zoomsadmin@cluster0.2lckxfq.mongodb.net/?appName=Cluster0

# Option B: local MongoDB Community Server installed on your machine
# MONGO_URI=mongodb://127.0.0.1:27017/zoomsDB

# ---- Session secret (any random long string) ----
SESSION_SECRET=change_this_to_any_long_random_string

# ---- Port the app runs on ----
PORT=3000
